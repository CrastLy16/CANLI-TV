<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Kurum agi sertifikalari (sistem ve kullanici tarafindan yuklenen guvenilir CA'lar)
         ve kullanici HTTPS-only modunu kapattiginda mobil veride HTTP radyo akislari icin -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
